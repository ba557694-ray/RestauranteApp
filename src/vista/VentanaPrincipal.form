              <background color="16119546"/>
            </properties>
            <border type="empty">
              <font/>
              <size top="16" left="16" bottom="16" right="16"/>
            </border>
            <children>
              <grid id="a013" binding="panelMesas" layout-manager="BorderLayout" hgap="0" vgap="0">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                  <gridbag weightx="0.38" weighty="0.56"/>
                </constraints>
                <properties>
                  <background color="16777215"/>
                </properties>
                <border type="none"/>
                <children>
                  <component id="a014" class="javax.swing.JLabel" binding="etiquetaTituloMesas">
                    <constraints border-constraint="North"/>
                    <properties>
                      <font name="Segoe UI" size="16" style="1"/>
                      <foreground color="1973805"/>
                      <text value="Mesas"/>
                    </properties>
                  </component>
                  <grid id="a015" binding="panelBotonesMesas" layout-manager="BorderLayout" hgap="0" vgap="0">
                    <constraints border-constraint="Center"/>
                    <properties>
                      <background color="16777215"/>
                    </properties>
                    <border type="empty">
                      <font/>
                      <size top="0" left="16" bottom="16" right="16"/>
                    </border>
                    <children/>
                  </grid>
                </children>
              </grid>
              <grid id="a016" binding="panelOrden" layout-manager="BorderLayout" hgap="0" vgap="0">
                <constraints>
                  <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                  <gridbag weightx="0.62" weighty="0.56"/>
                </constraints>
                <properties>
                  <background color="16777215"/>
                </properties>
                <border type="none"/>
                <children>
                  <component id="a017" class="javax.swing.JLabel" binding="etiquetaTituloOrden">
