      <grid id="a00e" binding="panelDerecha" layout-manager="BorderLayout" hgap="0" vgap="0">
        <constraints border-constraint="Center"/>
        <properties>
          <background color="16119546"/>
        </properties>
        <border type="none"/>
        <children>
          <grid id="a00f" binding="panelSuperior" layout-manager="BorderLayout" hgap="0" vgap="0">
            <constraints border-constraint="North"/>
            <properties>
              <background color="16777215"/>
              <minimumSize width="-1" height="72"/>
              <preferredSize width="-1" height="72"/>
            </properties>
            <border type="empty">
              <font/>
              <size top="18" left="24" bottom="18" right="24"/>
            </border>
            <children>
              <component id="a010" class="javax.swing.JLabel" binding="etiquetaTitulo">
                <constraints border-constraint="West"/>
                <properties>
                  <font name="Segoe UI" size="22" style="1"/>
                  <foreground color="1973805"/>
                  <text value="Sistema de Gestión de Restaurante"/>
                </properties>
              </component>
              <component id="a011" class="javax.swing.JLabel" binding="etiquetaUsuario">
                <constraints border-constraint="East"/>
                <properties>
                  <font name="Segoe UI" size="14" style="0"/>
                  <foreground color="7105664"/>
                  <horizontalAlignment value="4"/>
                  <text value="Mesero: Juan Pérez"/>
                </properties>
              </component>
            </children>
          </grid>
          <grid id="a012" binding="panelCentral" layout-manager="GridBagLayout">
