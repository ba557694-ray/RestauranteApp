                    <border type="none"/>
                    <children>
                      <component id="a019" class="javax.swing.JTable" binding="tablaOrden">
                        <constraints/>
                        <properties>
                          <background color="16777215"/>
                          <gridColor color="15001327"/>
                          <showGrid value="false"/>
                        </properties>
                      </component>
                    </children>
                  </scrollpane>
                  <grid id="a01a" binding="panelTotal" layout-manager="BorderLayout" hgap="0" vgap="0">
                    <constraints border-constraint="South"/>
                    <properties>
                      <background color="16448252"/>
                    </properties>
                    <border type="empty">
                      <font/>
                      <size top="10" left="16" bottom="12" right="16"/>
                    </border>
                    <children>
