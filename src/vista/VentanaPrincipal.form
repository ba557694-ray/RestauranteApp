<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="vista.VentanaPrincipal">
  <grid id="a001" binding="panelPrincipal" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="0" y="0" width="1280" height="780"/>
    </constraints>
    <properties>
      <background color="16119546"/>
      <minimumSize width="1100" height="700"/>
      <preferredSize width="1280" height="780"/>
    </properties>
    <border type="none"/>
    <children>
      <grid id="a002" binding="panelLateral" layout-manager="BorderLayout" hgap="0" vgap="0">
        <constraints border-constraint="West"/>
        <properties>
          <background color="1973805"/>
          <minimumSize width="230" height="-1"/>
          <preferredSize width="230" height="-1"/>
        </properties>
        <border type="none"/>
        <children>
          <grid id="a003" binding="panelLogo" layout-manager="GridBagLayout">
            <constraints border-constraint="North"/>
            <properties>
              <background color="1973805"/>
            </properties>
            <border type="empty">
              <font/>
              <size top="28" left="18" bottom="18" right="18"/>
            </border>
            <children>
              <component id="a004" class="javax.swing.JLabel" binding="etiquetaLogo">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                  <gridbag weightx="1.0" weighty="0.0"/>
                </constraints>
                <properties>
                  <font name="Segoe UI" size="40" style="1"/>
                  <foreground color="15105570"/>
                  <horizontalAlignment value="0"/>
                  <text value="R"/>
                </properties>
              </component>
              <component id="a005" class="javax.swing.JLabel" binding="etiquetaNombreRestaurante">
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                  <gridbag weightx="1.0" weighty="0.0"/>
                </constraints>
                <properties>
                  <font name="Segoe UI" size="18" style="1"/>
                  <foreground color="16777215"/>
                  <horizontalAlignment value="0"/>
                  <text value="RESTAURANTE"/>
                </properties>
              </component>
              <component id="a006" class="javax.swing.JLabel" binding="etiquetaEslogan">
                <constraints>
                  <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                  <gridbag weightx="1.0" weighty="0.0"/>
                </constraints>
                <properties>
                  <font name="Segoe UI" size="10" style="0"/>
                  <foreground color="12105927"/>
                  <horizontalAlignment value="0"/>
                  <text value="LA CASITA"/>
                </properties>
              </component>
            </children>
          </grid>
          <grid id="a007" binding="panelNavegacion" layout-manager="GridBagLayout">
            <constraints border-constraint="Center"/>
            <properties>
              <background color="1973805"/>
            </properties>
            <border type="empty">
              <font/>
              <size top="0" left="14" bottom="18" right="14"/>
            </border>
            <children>
              <component id="a008" class="javax.swing.JButton" binding="botonMesas">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                  <gridbag weightx="1.0" weighty="0.0"/>
                </constraints>
                <properties>
                  <background color="1973805"/>
                  <borderPainted value="false"/>
                  <contentAreaFilled value="true"/>
                  <focusPainted value="false"/>
                  <font name="Segoe UI" size="14" style="1"/>
                  <foreground color="12105927"/>
                  <horizontalAlignment value="2"/>
                  <preferredSize width="-1" height="44"/>
                  <text value="Mesas"/>
                </properties>
              </component>
              <component id="a009" class="javax.swing.JButton" binding="botonPedidos">
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                  <gridbag weightx="1.0" weighty="0.0"/>
                </constraints>
                <properties>
                  <background color="1973805"/>
                  <borderPainted value="false"/>
                  <contentAreaFilled value="true"/>
                  <focusPainted value="false"/>
                  <font name="Segoe UI" size="14" style="1"/>
                  <foreground color="12105927"/>
                  <horizontalAlignment value="2"/>
                  <preferredSize width="-1" height="44"/>
                  <text value="Pedidos"/>
                </properties>
              </component>
              <component id="a00a" class="javax.swing.JButton" binding="botonReportes">
                <constraints>
                  <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                  <gridbag weightx="1.0" weighty="0.0"/>
                </constraints>
                <properties>
                  <background color="1973805"/>
                  <borderPainted value="false"/>
                  <contentAreaFilled value="true"/>
                  <focusPainted value="false"/>
                  <font name="Segoe UI" size="14" style="1"/>
                  <foreground color="12105927"/>
                  <horizontalAlignment value="2"/>
                  <preferredSize width="-1" height="44"/>
                  <text value="Reportes"/>
                </properties>
              </component>
              <component id="a00b" class="javax.swing.JButton" binding="botonConfiguracion">
                <constraints>
                  <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                  <gridbag weightx="1.0" weighty="0.0"/>
                </constraints>
                <properties>
                  <background color="1973805"/>
                  <borderPainted value="false"/>
                  <contentAreaFilled value="true"/>
                  <focusPainted value="false"/>
                  <font name="Segoe UI" size="14" style="1"/>
                  <foreground color="12105927"/>
                  <horizontalAlignment value="2"/>
                  <preferredSize width="-1" height="44"/>
                  <text value="Configuración"/>
                </properties>
              </component>
              <component id="a00c" class="javax.swing.JPanel">
                <constraints>
                  <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                  <gridbag weightx="1.0" weighty="1.0"/>
                </constraints>
                <properties>
                  <background color="1973805"/>
                </properties>
              </component>
              <component id="a00d" class="javax.swing.JButton" binding="botonCerrarSesion">
                <constraints>
                  <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                  <gridbag weightx="1.0" weighty="0.0"/>
                </constraints>
                <properties>
                  <background color="1973805"/>
                  <borderPainted value="false"/>
                  <contentAreaFilled value="true"/>
                  <focusPainted value="false"/>
