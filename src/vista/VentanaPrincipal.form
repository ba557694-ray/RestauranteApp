                        <constraints border-constraint="West"/>
                        <properties>
                          <font name="Segoe UI" size="15" style="1"/>
                          <foreground color="7105664"/>
                          <text value="Total:"/>
                        </properties>
                      </component>
                      <component id="a01c" class="javax.swing.JLabel" binding="etiquetaTotal">
                        <constraints border-constraint="East"/>
                        <properties>
                          <font name="Segoe UI" size="22" style="1"/>
                          <foreground color="15105570"/>
                          <horizontalAlignment value="4"/>
                          <text value="$0.00"/>
                        </properties>
                      </component>
                    </children>
                  </grid>
                </children>
              </grid>
              <grid id="a01d" binding="panelPlatillos" layout-manager="BorderLayout" hgap="0" vgap="0">
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                  <gridbag weightx="0.38" weighty="0.44"/>
