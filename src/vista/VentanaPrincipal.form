                    <properties>
                      <font name="Segoe UI" size="16" style="1"/>
                      <foreground color="1973805"/>
                      <text value="Orden de la Mesa 1"/>
                    </properties>
                  </component>
                  <scrollpane id="a018" binding="panelDesplazamientoOrden">
                    <constraints border-constraint="Center"/>
                    <properties>
                      <horizontalScrollBarPolicy value="31"/>
                      <verticalScrollBarPolicy value="20"/>
