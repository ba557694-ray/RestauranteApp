                          <gridbag weightx="1.0" weighty="1.0"/>
                        </constraints>
                        <properties>
                          <background color="1973805"/>
                          <borderPainted value="false"/>
                          <contentAreaFilled value="true"/>
                          <focusPainted value="false"/>
                          <font name="Segoe UI" size="15" style="1"/>
