@startuml
left to right direction
skinparam defaultFontName Segoe UI
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #E8F5E9
  BorderColor #2E7D32
  ArrowColor #37474F
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #1E1E2D
}

actor "Mesero" as Mesero
actor "Cocina" as Cocina
actor "Terminal Bancaria" as Terminal

rectangle "Sistema de Gestión de Restaurante" {
  usecase "Iniciar sesión" as UC01
  usecase "Consultar mesas" as UC02
  usecase "Abrir mesa" as UC03
  usecase "Tomar pedido" as UC04
  usecase "Agregar platillo" as UC05
  usecase "Marcar platillo como entregado" as UC06
  usecase "Generar cuenta" as UC07
  usecase "Registrar pago" as UC08
  usecase "Pagar en efectivo" as UC09
  usecase "Pagar con terminal" as UC10
  usecase "Consultar reportes" as UC11
  usecase "Configurar preferencias" as UC12
  usecase "Cerrar sesión" as UC13
  usecase "Consultar pedidos pendientes" as UC14
}

Mesero --> UC01
Mesero --> UC02
Mesero --> UC03
Mesero --> UC04
Mesero --> UC06
Mesero --> UC07
Mesero --> UC08
Mesero --> UC09
Mesero --> UC10
Mesero --> UC11
Mesero --> UC12
Mesero --> UC13

Cocina --> UC06
Cocina --> UC14
Terminal --> UC10

UC04 ..> UC05 : <<include>>
UC08 ..> UC07 : <<include>>
UC09 .> UC08 : <<extend>>
UC10 .> UC08 : <<extend>>
UC06 ..> UC14 : <<include>>

@enduml
