@startuml
skinparam defaultFontName Segoe UI
skinparam shadowing false
skinparam object {
  BackgroundColor #FFFFFF
  BorderColor #37474F
  ArrowColor #37474F
}

object "ventana : VentanaPrincipal" as ventana {
  mesaSeleccionada = 1
}

object "servicio : ServicioRestaurante" as servicio

object "mesaDAO : MesaDAO" as mesaDAO
object "pedidoDAO : PedidoDAO" as pedidoDAO
object "conexion : ConexionBD" as conexion

object "mesa1 : Mesa" as mesa1 {
  idMesa = 1
  numero = 1
  capacidad = 4
  estado = "Ocupada"
  ubicacion = "Salón principal"
}

