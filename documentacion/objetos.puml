  precio = 120.00
  categoria = "Platillo fuerte"
  disponible = true
}

ventana --> servicio : utiliza
servicio --> mesaDAO : consulta
servicio --> pedidoDAO : consulta
mesaDAO --> conexion : usa
pedidoDAO --> conexion : usa
servicio o-- tacos : ofrece
servicio o-- horchata : ofrece
servicio o-- enchiladas : ofrece
mesa1 -- pedido1
mesa1 -- pedido2
mesa2 -- pedido3
mesa3 -- pedido4
mesa3 -- pedido5

@enduml
